generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Loan {
  id        Int       @id @default(autoincrement())
  loanId    Int       @unique
  borrower  String
  principal BigInt
  interest  BigInt
  termDays  Int
  dueAt     DateTime
  status    LoanStatus @default(ACTIVE)
  txHash    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([borrower])
  @@index([status])
}

model ScoreSnapshot {
  id         Int      @id @default(autoincrement())
  address    String
  score      Int
  breakdown  Json
  snapshotAt DateTime @default(now())

  @@index([address])
  @@index([snapshotAt])
}

model User {
  address    String   @id
  nonce      String
  createdAt  DateTime @default(now())
  lastLogin  DateTime?
}

enum LoanStatus {
  ACTIVE
  REPAID
  DEFAULTED
}
